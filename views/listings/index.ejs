<% layout("/layouts/boilerplate") %>
<body>
    <!-- <h3>All Listings </h3> -->
    <!-- <form method="GET" action="/listings/new">
        <button>Create New Listing</button>
    </form> -->

    <!-- <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
        }

        .filter {
            text-align: center;
            margin-right: 2rem;
            margin-top: 1rem;
            opacity: 0.7;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter p {
            font-size: 0.8rem;
        }
    </style> -->

    <div id="filters">
        <a href="/listings?category=Trending" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Trending') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
        </a>
        <a href="/listings?category=Rooms" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Rooms') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
        </a>
        <a href="/listings?category=Iconic Cities" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Iconic Cities') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </div>
        </a>
        <a href="/listings?category=Mountains" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Mountains') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
        </a>
        <a href="/listings?category=Castles" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && (category === 'Castles' || category === 'Castel')) ? 'active-filter' : '' %>">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
        </a>
        <a href="/listings?category=Amazing Pools" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Amazing Pools') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-person-swimming fa-flip-horizontal"></i></div>
                <p>Amazing Pools</p>
            </div>
        </a>
        <a href="/listings?category=Camping" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Camping') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
        </a>
        <a href="/listings?category=Farms" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Farms') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </div>
        </a>
        <a href="/listings?category=Arctic" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Arctic') ? 'active-filter' : '' %>">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p>Arctic</p>
            </div>
        </a>
        <a href="/listings?category=Domes" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Domes') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-igloo"></i></div>
                <p>Domes</p>
            </div>
        </a>
        <a href="/listings?category=Boats" class="filter-link">
            <div class="filter <%= (typeof category !== 'undefined' && category === 'Boats') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-ship"></i></div>
                <p>Boats</p>
            </div>
        </a>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
              <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
              <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>

    <% if ((typeof q !== 'undefined' && q) || (typeof category !== 'undefined' && category)) { %>
        <div class="mt-3 mb-3 d-flex align-items-center justify-content-between alert alert-light border">
            <div>
                <span class="fw-bold">Active Filters:</span>
                <% if (typeof q !== 'undefined' && q) { %>
                    <span class="badge bg-danger ms-2">Search: "<%= q %>"</span>
                <% } %>
                <% if (typeof category !== 'undefined' && category) { %>
                    <span class="badge bg-dark ms-2">Category: "<%= category %>"</span>
                <% } %>
            </div>
            <a href="/listings" class="btn btn-outline-dark btn-sm">Clear Filters</a>
        </div>
    <% } %>

    <% if (allListings.length === 0) { %>
        <div class="alert alert-warning col-6 offset-3 mt-4 text-center" role="alert">
            <h4><i class="fa-solid fa-circle-exclamation me-2"></i>No listings found</h4>
            <p>Try searching for a different destination or category.</p>
            <a href="/listings" class="btn btn-dark btn-sm mt-2">View All Listings</a>
        </div>
    <% } else { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for (let list of allListings) { %>
                <a href="/listings/<%= list._id %>" class="listing-link">
                    <div class="card col listing-card">
                      <img src="<%= list.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                      <div class="card-img-overlay"></div>
                      <div class="card-body">
                          <p class="card-text">
                            <b><%= list.title %></b>
                            <br>
                            &#8377; <%= list.price.toLocaleString("en-IN") %> / night
                            <i class="tax-info"> &nbsp; &nbsp; +18% GST </i>
                          </p>
                      </div>
                    </div>
                </a> 
            <% } %>
        </div>
    <% } %>

    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (info of taxInfo){
                if (info.style.display != "inline"){
                    info.style.display = "inline";
                } else {
                    info.style.display ="none";
                }
            }
        });
    </script>


</body>



